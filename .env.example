# Single secrets file (git-ignored). Copy to `.env` and fill in.
# Secrets are stored ENCRYPTED (Fernet); the app decrypts on the fly at use time.
# Nothing sensitive lives in YAML configs after migration.

# Fernet key (generated on first run if missing). Keep secret, keep the file 0600.
FARM_SECRET_KEY=
# Salt for SHA-256 hashing + key handling (generated on first run if missing).
FARM_SALT=

# Optional: plaintext operator override for HF (takes precedence if set).
# Prefer the encrypted form below instead.
#HF_TOKEN=

# Encrypted HF token (set via Settings UI or migrate script). Fernet token, not plaintext.
HF_TOKEN_ENC=

# Per-machine SSH passwords, encrypted. One line per machine id:
#   MACHINE_<UPPER_SNAKE_ID>_PASSWORD_ENC=<fernet token>
# e.g. MACHINE_AIBOX1_PASSWORD_ENC=gAAAAA...
# Set via Machines UI or:  .venv/bin/python scripts/migrate_secrets_to_env.py
