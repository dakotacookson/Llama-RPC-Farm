FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tar libgomp1 procps util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY peer_agent /app/peer_agent
RUN pip install /app/peer_agent

EXPOSE 8198
CMD ["python", "-m", "llama_peer_agent", "--host", "0.0.0.0"]
