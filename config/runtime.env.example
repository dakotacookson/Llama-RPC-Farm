# Optional runtime environment, sourced by run.sh and restart.sh.
# Copy to config/runtime.env (git-ignored) and edit.
#
# Reverse proxy / public access (safe defaults):
FARM_TRUSTED_PROXIES=127.0.0.1
FARM_REQUIRE_AUTH=1
FARM_GATEWAY_REQUIRE_KEYS=1
#
# Set only when the UI itself is reached exclusively over HTTPS:
# FARM_COOKIE_SECURE=1
#
# Bind the gateway to loopback when nginx is the only public listener:
# GATEWAY_HOST=127.0.0.1
#
# Disable the embedded :8090 gateway if you run an external one:
# FARM_GATEWAY_DISABLE=1
